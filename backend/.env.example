# Copy this file to backend/.env and paste your API keys.
# backend/.env is gitignored and never leaves the server.

# Google Gemini API key (read only by backend/gemini_service.py). Not
# currently wired into server.py — kept for tooling/compat.
GEMINI_API_KEY=

# Groq API key + model for the AI endpoints.
# GROQ_API_KEY is read only by the Python backend (backend/groq_service.py)
# and never shipped to the browser. GROQ_MODEL defaults to the built-in
# default when left empty.
GROQ_API_KEY=
GROQ_MODEL=

# Optional: YouTube Data API key. When present, video search uses the Data
# API (more reliable); when absent, the backend falls back to yt-dlp.
YOUTUBE_API_KEY=

# ── Deployment (optional; defaults work for local dev) ────────────────
# Port the backend listens on. FOCLEARN_PORT/PORT overrides.
PORT=8787

# Bind address. 0.0.0.0 makes the API reachable from other machines/containers.
FOCUSLEARN_HOST=0.0.0.0

# Comma-separated browser origins allowed to make credentialed /api calls,
# e.g. CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# Leave empty to reflect the request Origin (local development behaviour).
CORS_ALLOWED_ORIGINS=

# Set to 1 when serving behind HTTPS so session cookies get the Secure flag.
FOCUSLEARN_HTTPS=

# Set to None only when the frontend is hosted on a different origin than
# the API (requires HTTPS). Defaults to Lax.
FOCUSLEARN_COOKIE_SAMESITE=