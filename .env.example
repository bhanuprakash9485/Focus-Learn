# FocusLearn environment variables (copy to .env for local dev)
#
# The YouTube search is powered by a small Python backend that uses
# yt-dlp (backend/server.py + backend/youtube_service.py). No YouTube
# Data API key is needed.
#
# The Vite dev server proxies /api requests to the Python backend on
# port 8787 (override with FOCUSLEARN_PORT). In production, either let
# the Python backend serve the built frontend (same origin), or deploy
# the frontend separately and point this at the backend, e.g.
#
#     VITE_API_BASE_URL=https://api.example.com
#
# Only VITE_* variables ever reach the browser.
VITE_API_BASE_URL=
VITE_YOUTUBE_API_KEY=

# Google sign-in ("Continue with Google"). This Client ID is a PUBLIC
# identifier (safe for the browser — never put a Client Secret here).
# Create one in the Google Cloud Console:
#   APIs & Services → OAuth consent screen → Create consent screen
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#     Application type: Web application
#     Authorized JavaScript origins:
#       http://localhost:5173
#       https://<your-deployed-frontend-domain>
# Then paste the CLIENT ID below and set the matching GOOGLE_CLIENT_ID in
# backend/.env. The backend verifies the Google token with Google's
# tokeninfo endpoint (no Client Secret is needed for this flow).
VITE_GOOGLE_CLIENT_ID=

# Firebase Web SDK config for "Continue with Google" (POST /api/auth/firebase).
# Get these from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and config.
# These values are PUBLIC browser identifiers (safe to ship) — never put a
# service-account key or Admin private key here. Leave them blank to hide
# Google sign-in; email/password login still works.
# The backend verifies the Firebase ID token and must know the SAME project id
# (FIREBASE_PROJECT_ID in backend/.env).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini API key for the backend's AI Learning Guide endpoint
# (POST /api/ai/learning-guide). Live in backend/.env (not here, unless you
# export it in the environment). Only VITE_* variables ever reach the
# browser, so this never appears in client-side JavaScript.
GEMINI_API_KEY=

# Groq API key + model for the AI Learning Guide endpoint. Live in
# backend/.env — this file should never contain real keys.
GROQ_API_KEY=
GROQ_MODEL=